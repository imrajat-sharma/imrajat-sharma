{
  "name": "github-profile-readme-generator",
  "version": "1.0.0",
  "description": "Automatically generate a beautiful GitHub Profile README with ASCII avatar and live stats",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --loader tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "generate": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "github",
    "profile",
    "readme",
    "generator",
    "ascii",
    "avatar"
  ],
  "author": "Rajat Sharma",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "octokit": "^3.1.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
